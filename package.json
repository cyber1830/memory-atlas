{
  "name": "memory-layer",
  "version": "0.1.0",
  "description": "Graph-native agent memory layer for cross-session continuity (LongMemEval / BEAM hackathon track)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "eval": "ts-node-dev --transpile-only src/eval/runLongMemEval.ts",
    "eval:normalize": "ts-node-dev --transpile-only src/eval/normalizeLongMemEval.ts"
    ,"test:extractive": "npm run build && node dist/eval/testExtractive.js"
  },
  "dependencies": {
    "@hydradb/sdk": "^2.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
