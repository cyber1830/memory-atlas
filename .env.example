# Required for graph-native ingestion and retrieval — get one at https://hydradb.com
HYDRA_DB_API_KEY=

# Optional local model (Ollama; defaults to qwen2.5:7b)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=8000
OLLAMA_NUM_CTX=8192

# Local benchmark safeguard; set to 0 only with a large-context model.
BASELINE_MAX_CHARS=20000

# Optional
PORT=3000
HYDRA_DATABASE=memory-layer
